{
  "defaultApplyToLists": ["green"],
  "sources": [
    {
      "id": "fda-serving-size-guidance",
      "label": "FDA Reference Amounts Customarily Consumed (RACC)",
      "url": "https://www.ecfr.gov/current/title-21/chapter-I/subchapter-B/part-101/subpart-A/section-101.12"
    },
    {
      "id": "usda-foodsafety-egg-portion",
      "label": "USDA egg handling and serving references",
      "url": "https://www.fsis.usda.gov/food-safety/safe-food-handling-and-preparation/eggs"
    },
    {
      "id": "myplate-fruit-serving",
      "label": "USDA MyPlate food group examples",
      "url": "https://www.myplate.gov/eat-healthy/fruits"
    },
    {
      "id": "myplate-veg-serving",
