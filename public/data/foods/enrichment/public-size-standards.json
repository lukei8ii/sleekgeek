  "rules": [
    {
      "id": "protein-red-meat-cuts",
      "applyToGroupIds": ["quality-protein"],
      "matchAny": ["-beef", "-lamb", "-pork", "-wild-game", "-ostrich"],
      "packageSize": { "servings": 4, "unit": "16 oz package" },
      "defaultPortion": { "amount": 4, "unit": "oz" },
      "packageSource": "Public standard: fresh red meat pack",
      "confidence": "high",
      "references": ["myplate-protein-serving", "fda-serving-size-guidance"]
    },
    {
      "id": "protein-poultry-cuts",
      "applyToGroupIds": ["quality-protein"],
      "matchAny": ["-chicken", "-turkey", "-duck"],
      "excludeAny": ["deep-fried"],
      "packageSize": { "servings": 4, "unit": "16 oz package" },
      "defaultPortion": { "amount": 4, "unit": "oz" },
      "packageSource": "Public standard: fresh poultry pack",
      "confidence": "high",
      "references": ["myplate-protein-serving", "fda-serving-size-guidance"]
    },
    {
      "id": "protein-eggs-carton",
      "applyToGroupIds": ["quality-protein"],
      "matchAny": ["-eggs"],
      "packageSize": { "servings": 6, "unit": "12-count carton" },
      "defaultPortion": { "amount": 2, "unit": "eggs" },
      "packageSource": "Public standard: 12-count carton, 2-egg serving",
      "confidence": "high",
      "references": ["usda-foodsafety-egg-portion", "fda-serving-size-guidance"]
    },
    {
